{
  "name": "private-messenger-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "prisma generate && next build --webpack",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "cap:sync:ios:local": "CAPACITOR_SERVER_URL=http://localhost:3000 npx cap sync ios",
    "validate:grouping": "tsx scripts/validate-message-grouping.ts",
    "validate:history-availability": "tsx scripts/validate-history-availability.ts",
    "validate:chat-scroll-anchor": "node scripts/validate-chat-scroll-anchor.mjs",
    "validate:backup-crypto": "tsx scripts/validate-backup-crypto.ts",
    "validate:backup-flags": "tsx scripts/validate-backup-flags.ts",
    "validate:backup-db-isolation": "tsx scripts/validate-backup-db-isolation.ts",
    "validate:backup-roundtrip": "tsx scripts/validate-backup-roundtrip.ts",
    "validate:chat-theme-consistency": "tsx scripts/validate-chat-theme-consistency.ts",
    "validate:backup-record": "tsx scripts/validate-backup-record.ts",
    "validate:message-send-reconciliation": "tsx scripts/validate-message-send-reconciliation.ts",
    "validate:message-send-idempotency": "tsx scripts/validate-message-send-idempotency.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "firebase-admin": "^14.2.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.9.0",
    "next": "16.2.9",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "esbuild": "0.28.1",
    "postcss": "8.5.10"
  }
}
