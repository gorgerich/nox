generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                   @id @default(uuid())
  email                      String?                  @unique
  login                      String?                  @unique
  username                   String                   @unique
  passwordHash               String?
  status                     UserStatus               @default(PENDING)
  role                       UserRole                 @default(MEMBER)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  lastSeenAt                 DateTime?
  adminActions               AdminActionLog[]         @relation("AdminActions")
  attachments                Attachment[]
  callSessions               CallSession[]            @relation("CallCreator")
  sentCallLogs               CallLog[]                @relation("CallLogCaller")
  receivedCallLogs           CallLog[]                @relation("CallLogCallee")
  createdChats               Chat[]                   @relation("ChatCreator")
  chatMembers                ChatMember[]
  sentChatRequests           ChatRequest[]            @relation("SentChatRequests")
  receivedChatRequests       ChatRequest[]            @relation("ReceivedChatRequests")
  contactSettingsOwned       ContactSettings[]        @relation("ContactSettingsOwner")
  contactSettingsTargetingMe ContactSettings[]        @relation("ContactSettingsTarget")
  devices                    Device[]
  createdInvites             Invite[]                 @relation("InviteCreator")
  messages                   Message[]
  messageReceipts            MessageReceipt[]
  profile                    Profile?
  pushSubscriptions          PushSubscription[]
  reactions                  Reaction[]
  mediaKeyEnvelopes          MediaKeyEnvelope[]       @relation("MediaKeyEnvelopeRecipientUser")
  keyBundle                  UserKeyBundle?
  e2eeDevices                UserDevice[]
  deviceKeyBundles           DeviceKeyBundle[]
  e2eeTrustOwned             E2EEDeviceTrust[]        @relation("E2EETrustOwner")
  e2eeTrustTargetingMe       E2EEDeviceTrust[]        @relation("E2EETrustTarget")
  receivedMessageEnvelopes   MessageEnvelope[]        @relation("MessageEnvelopeRecipientUser")
  passwordResetTokens        PasswordResetToken[]
  accountRecoveryRequests    AccountRecoveryRequest[]
  backupAccount              BackupAccount?

  @@index([status])
  @@index([role])
}

model AccountRecoveryRequest {
  id                 String    @id @default(cuid())
  userId             String
  publicCode         String    @unique
  status             String    @default("PENDING") // PENDING | APPROVED | DENIED | EXPIRED | USED
  requesterIpHash    String?
  requesterUserAgent String?
  approvedByDeviceId String?
  approvedAt         DateTime?
  deniedAt           DateTime?
  usedAt             DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ipHash    String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserKeyBundle {
  id                String   @id @default(uuid())
  userId            String   @unique
  ecdhPublicKey     String
  identityPublicKey String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDevice {
  id         String           @id @default(cuid())
  userId     String
  deviceId   String           @unique
  name       String?
  userAgent  String?
  platform   String?
  createdAt  DateTime         @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyBundle  DeviceKeyBundle?

  @@index([userId])
  @@index([revokedAt])
}

model DeviceKeyBundle {
  id           String     @id @default(cuid())
  userDeviceId String     @unique
  userId       String
  deviceId     String
  publicKey    String
  algorithm    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  revokedAt    DateTime?
  userDevice   UserDevice @relation(fields: [userDeviceId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([revokedAt])
}

model E2EEDeviceTrust {
  id                   String    @id @default(cuid())
  ownerId              String
  targetUserId         String
  targetDeviceId       String
  publicKeyFingerprint String
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  owner                User      @relation("E2EETrustOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUser           User      @relation("E2EETrustTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, targetDeviceId, publicKeyFingerprint])
  @@index([ownerId])
  @@index([targetUserId])
  @@index([targetDeviceId])
}

model ContactSettings {
  id           String   @id @default(uuid())
  ownerId      String
  targetUserId String
  nickname     String?
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation("ContactSettingsOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUser   User     @relation("ContactSettingsTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, targetUserId])
  @@index([ownerId])
  @@index([targetUserId])
}

model PushSubscription {
  id         String    @id @default(uuid())
  userId     String
  // "webpush" (endpoint = push service URL, p256dh/auth set) or
  // "fcm" (endpoint = FCM device token, p256dh/auth empty strings).
  kind       String    @default("webpush")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?
  disabledAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  displayName      String
  avatarUrl        String?
  bio              String?
  showOnline       Boolean  @default(false)
  showReadReceipts Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id              String       @id @default(uuid())
  codeHash        String       @unique
  createdByUserId String
  targetEmail     String?
  targetUsername  String?
  maxUses         Int          @default(1)
  usedCount       Int          @default(0)
  status          InviteStatus @default(ACTIVE)
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  createdBy       User         @relation("InviteCreator", fields: [createdByUserId], references: [id])

  @@index([status])
  @@index([targetEmail])
  @@index([targetUsername])
}

model Device {
  id                    String       @id @default(uuid())
  userId                String
  deviceName            String
  deviceFingerprintHash String
  platform              String
  pushToken             String?
  status                DeviceStatus @default(ACTIVE)
  lastSeenAt            DateTime     @default(now())
  createdAt             DateTime     @default(now())
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Chat {
  id                  String        @id @default(uuid())
  type                ChatType
  title               String?
  avatarUrl           String?
  createdByUserId     String
  isLocked            Boolean       @default(false)
  disappearingSeconds Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  pinnedMessageId     String?       @unique
  calls               CallSession[]
  callLogs            CallLog[]
  createdBy           User          @relation("ChatCreator", fields: [createdByUserId], references: [id])
  pinnedMessage       Message?      @relation("PinnedChatMessage", fields: [pinnedMessageId], references: [id])
  members             ChatMember[]
  messages            Message[]

  @@index([type])
  @@index([updatedAt])
}

model ChatMember {
  id                String           @id @default(uuid())
  chatId            String
  userId            String
  role              ChatMemberRole   @default(MEMBER)
  status            ChatMemberStatus @default(ACTIVE)
  joinedAt          DateTime         @default(now())
  lastReadMessageId String?
  lastReadAt        DateTime?
  mutedUntil        DateTime?
  pinnedAt          DateTime?
  archivedAt        DateTime?
  deletedAt         DateTime?
  clearedAt         DateTime?
  chat              Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@index([chatId])
  @@index([status])
  @@index([pinnedAt])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([clearedAt])
}

model Message {
  id                String            @id @default(uuid())
  chatId            String
  senderUserId      String
  body              String?
  ciphertext        String?
  iv                String?
  salt              String?
  algorithm         String?
  encryptionVersion Int?              @default(0)
  isEncrypted       Boolean           @default(false)
  senderKeyId       String?
  type              MessageType       @default(TEXT)
  replyToMessageId  String?
  editedAt          DateTime?
  deletedAt         DateTime?
  deliveredAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime          @default(now())
  attachments       Attachment[]
  pinnedInChat      Chat?             @relation("PinnedChatMessage")
  chat              Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  replyToMessage    Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies           Message[]         @relation("MessageReplies")
  sender            User              @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  receipts          MessageReceipt[]
  reactions         Reaction[]
  envelopes         MessageEnvelope[]

  @@index([chatId, createdAt])
  @@index([senderUserId])
}

model MessageEnvelope {
  id                        String    @id @default(cuid())
  messageId                 String
  recipientUserId           String
  recipientDeviceId         String
  senderDeviceId            String
  ciphertext                String?
  iv                        String?
  salt                      String?
  algorithm                 String
  encryptionVersion         Int       @default(2)
  createdAt                 DateTime  @default(now())
  deliveredAt               DateTime?
  readAt                    DateTime?
  encryptedPayloadDeletedAt DateTime?
  message                   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientUser             User      @relation("MessageEnvelopeRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientDeviceId])
  @@index([recipientUserId])
  @@index([recipientDeviceId])
  @@index([messageId])
}

model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

model Attachment {
  id                     String             @id @default(uuid())
  messageId              String
  uploaderUserId         String
  storageKey             String
  fileName               String
  mimeType               String
  sizeBytes              Int
  encryptedSizeBytes     Int?
  isEncrypted            Boolean            @default(false)
  mediaEncryptionVersion Int?
  fileIv                 String?
  fileAlgorithm          String?
  width                  Int?
  height                 Int?
  durationSeconds        Int?
  encryptionKeyId        String?
  createdAt              DateTime           @default(now())
  message                Message            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader               User               @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)
  mediaKeyEnvelopes      MediaKeyEnvelope[]

  @@index([messageId])
  @@index([uploaderUserId])
  @@index([isEncrypted])
}

model MediaKeyEnvelope {
  id                String     @id @default(cuid())
  attachmentId      String
  recipientUserId   String
  recipientDeviceId String
  senderDeviceId    String
  encryptedMediaKey String
  iv                String
  salt              String?
  algorithm         String
  encryptionVersion Int        @default(1)
  createdAt         DateTime   @default(now())
  deliveredAt       DateTime?
  revokedAt         DateTime?
  attachment        Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  recipientUser     User       @relation("MediaKeyEnvelopeRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, recipientDeviceId])
  @@index([recipientUserId])
  @@index([recipientDeviceId])
  @@index([attachmentId])
  @@index([revokedAt])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model CallSession {
  id               String     @id @default(uuid())
  chatId           String
  createdByUserId  String
  provider         String     @default("livekit")
  providerRoomName String
  type             CallType
  status           CallStatus @default(RINGING)
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime   @default(now())
  chat             Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdBy        User       @relation("CallCreator", fields: [createdByUserId], references: [id])

  @@index([chatId])
  @@index([status])
}

model CallLog {
  id          String    @id @default(cuid())
  chatId      String
  callerId    String
  calleeId    String
  status      String // missed | declined | completed | failed | canceled
  startedAt   DateTime  @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?
  durationSec Int?
  createdAt   DateTime  @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  caller User @relation("CallLogCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallLogCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([calleeId])
  @@index([chatId])
  @@index([startedAt])
}

model ChatRequest {
  id          String            @id @default(uuid())
  fromUserId  String
  toUserId    String
  status      ChatRequestStatus @default(PENDING)
  message     String?
  chatId      String?
  createdAt   DateTime          @default(now())
  respondedAt DateTime?
  fromUser    User              @relation("SentChatRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User              @relation("ReceivedChatRequests", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model AdminActionLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  ipHash      String?
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminActions", fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  REVOKED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChatMemberStatus {
  ACTIVE
  LEFT
  REMOVED
  BLOCKED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VIDEO_NOTE
  FILE
  VOICE
  SYSTEM
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

// ---------------------------------------------------------------------------
// E2EE backup domain (prototype, behind E2EE_BACKUP_* flags).
//
// Deliberately isolated from the messaging tables: nothing here references
// Message, MessageEnvelope or Device, so a backup failure cannot affect
// delivery. The server stores ciphertext and wrapped key material only — it
// never receives the recovery secret, the backup root key, a generation key,
// message plaintext, media keys or previews.
// ---------------------------------------------------------------------------

model BackupAccount {
  id                         String              @id @default(cuid())
  userId                     String              @unique
  backupVersion              Int                 @default(1)
  status                     BackupAccountStatus @default(DISABLED)
  /// Wrapped under a key derived from the user's recovery secret.
  wrappedRootKey             String?
  wrappedRootKeyNonce        String?
  wrappedRootKeySalt         String?
  latestCompleteGeneration   Int?
  previousCompleteGeneration Int?
  /// Server-configured, not a constant baked into the schema or client.
  quotaBytes                 BigInt?
  usedBytes                  BigInt              @default(0)
  reservedBytes              BigInt              @default(0)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  user                       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations                BackupGeneration[]

  @@index([status])
}

model BackupGeneration {
  id                        String                 @id @default(cuid())
  backupAccountId           String
  generationNumber          Int
  status                    BackupGenerationStatus @default(IN_PROGRESS)
  encryptedManifest         String?
  manifestNonce             String?
  wrappedGenerationKey      String?
  wrappedGenerationKeyNonce String?
  /// Chains generations so a broken or reordered history is detectable.
  previousManifestHash      String?
  totalChunks               Int                    @default(0)
  uploadedChunks            Int                    @default(0)
  totalBytes                BigInt                 @default(0)
  createdAt                 DateTime               @default(now())
  completedAt               DateTime?
  /// Unfinished generations are reaped after this instant.
  expiresAt                 DateTime?
  backupAccount             BackupAccount          @relation(fields: [backupAccountId], references: [id], onDelete: Cascade)
  chunks                    BackupChunk[]

  @@unique([backupAccountId, generationNumber])
  @@index([backupAccountId, status])
  @@index([expiresAt])
}

model BackupChunk {
  id           String           @id @default(cuid())
  generationId String
  chunkIndex   Int
  /// AES-GCM ciphertext; the auth tag is part of this value.
  ciphertext   String
  nonce        String
  byteLength   Int
  createdAt    DateTime         @default(now())
  generation   BackupGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, chunkIndex])
  @@index([generationId])
}

enum BackupAccountStatus {
  DISABLED
  ACTIVE
  PAUSED
  ERROR
}

enum BackupGenerationStatus {
  IN_PROGRESS
  COMPLETE
  FAILED
  SUPERSEDED
}
